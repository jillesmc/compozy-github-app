{
  "name": "github-app-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && bun build src/index.ts --target=node --outfile=dist/index.js && rm -rf dist/bin dist/docs && cp -r bin docs dist/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "mutation": "bun scripts/mutation.ts"
  },
  "dependencies": {
    "@compozy/extension-sdk": "0.7.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
